# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build files
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / lint caches
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.bak

# Python tooling
.python-version

# Generated experiment/results data
results/*
!results/.gitkeep

# Generated experiment outputs
experiments/outputs/
experiments/runs/

# Numerical / scientific generated data
*.npy
*.npz
*.h5
*.hdf5

# Generated plots
*.png
*.jpg
*.jpeg
*.svg

# Keep PWA/docs/source assets if explicitly tracked
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.svg